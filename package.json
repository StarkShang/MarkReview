{
  "name": "markreview",
  "displayName": "MarkReview",
  "description": "%extension.description%",
  "version": "0.0.3",
  "publisher": "StarkShang",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#17485C",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markReview.addComment",
        "title": "%command.addComment%",
        "icon": "$(comment-add)"
      },
      {
        "command": "markReview.replaceSuggestion",
        "title": "%command.replaceSuggestion%",
        "icon": "$(replace)"
      },
      {
        "command": "markReview.delete",
        "title": "%command.delete%",
        "icon": "$(trash)"
      },
      {
        "command": "markReview.deleteReviewItem",
        "title": "%command.deleteReviewItem%",
        "icon": "$(trash)"
      },
      {
        "command": "markReview.addText",
        "title": "%command.addText%",
        "icon": "$(add)"
      },
      {
        "command": "markReview.cleanAcceptChanges",
        "title": "%command.cleanAcceptChanges%",
        "icon": "$(check)"
      },
      {
        "command": "markReview.exportAiPrompt",
        "title": "%command.exportAiPrompt%",
        "icon": "$(sparkle)"
      },
      {
        "command": "markReview.openPreview",
        "title": "%command.openPreview%",
        "icon": "$(preview)"
      },
      {
        "command": "markReview.openSource",
        "title": "%command.openSource%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markReview.togglePreview",
        "title": "%command.togglePreview%",
        "icon": "$(preview)"
      },
      {
        "command": "markReview.refreshComments",
        "title": "%command.refreshComments%",
        "icon": "$(refresh)"
      },
      {
        "command": "markReview.revealReviewItem",
        "title": "%command.revealReviewItem%",
        "icon": "$(go-to-file)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markReview",
          "title": "MarkReview",
          "icon": "resources/markreview.svg"
        }
      ]
    },
    "views": {
      "markReview": [
        {
          "id": "markReview.comments",
          "name": " ",
          "icon": "resources/markreview.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "markReview.comments",
        "contents": "%viewsWelcome.comments%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markReview.revealReviewItem",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "markReview.addComment",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "markReview.cleanAcceptChanges",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "markReview.exportAiPrompt",
          "when": "editorLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "markReview.togglePreview",
          "when": "editorLangId == markdown",
          "group": "navigation@4"
        },
        {
          "command": "markReview.togglePreview",
          "when": "activeWebviewPanelId == markReview.preview",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "markReview.togglePreview",
          "when": "view == markReview.comments && markReview.hasActiveMarkdownSource",
          "group": "navigation@1"
        },
        {
          "command": "markReview.addComment",
          "when": "view == markReview.comments && markReview.hasActiveMarkdownSource",
          "group": "navigation@2"
        },
        {
          "command": "markReview.cleanAcceptChanges",
          "when": "view == markReview.comments && markReview.hasActiveMarkdownSource",
          "group": "navigation@3"
        },
        {
          "command": "markReview.exportAiPrompt",
          "when": "view == markReview.comments && markReview.hasActiveMarkdownSource",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "markReview.revealReviewItem",
          "when": "view == markReview.comments && viewItem == markReviewReviewItem",
          "group": "inline@1"
        },
        {
          "command": "markReview.deleteReviewItem",
          "when": "view == markReview.comments && viewItem == markReviewReviewItem",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markReview.deleteReviewItem",
        "key": "delete",
        "mac": "backspace",
        "when": "focusedView == markReview.comments && markReview.hasActiveMarkdownSource"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/StarkShang/MarkReview.git"
  }
}
