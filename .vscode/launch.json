{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MarkReview Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/agents/vscode-extension-host/user-data",
        "--extensions-dir=${workspaceFolder}/agents/vscode-extension-host/extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}